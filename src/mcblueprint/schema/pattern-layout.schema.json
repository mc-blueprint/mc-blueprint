{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mc-blueprint.github.io/schema/pattern-layout.schema.json",
  "title": "敷地規則 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "name",
    "archetype",
    "style",
    "rules",
    "modules"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_-]*$"
    },
    "archetype": {
      "enum": [
        "castle",
        "town",
        "city",
        "terrain",
        "cave",
        "underground_city"
      ]
    },
    "style": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "plotWidth": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          }
        },
        "plotDepth": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          }
        },
        "roadWidth": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          }
        },
        "plazaSpacing": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          }
        },
        "wallSpacing": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          }
        },
        "towerSpacing": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          }
        },
        "floorClearance": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 2,
            "maximum": 256
          }
        },
        "ceilingClearance": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_-]*$"
      }
    }
  }
}
