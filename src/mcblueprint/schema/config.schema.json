{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "formatVersion": {"const": 1},
    "seed": {"type": ["integer", "null"]},
    "randomness": {"type": "number", "minimum": 0, "maximum": 1},
    "weathering": {"type": "object", "additionalProperties": false, "properties": {
      "age": {"$ref": "#/$defs/unit"}, "moss": {"type": "object", "additionalProperties": false, "properties": {
        "amount": {"$ref": "#/$defs/unit"}, "water_proximity": {"type": "object", "additionalProperties": false, "properties": {"weight": {"$ref": "#/$defs/unit"}, "radius": {"type": "integer", "minimum": 0}}},
        "ground_proximity": {"type": "object", "additionalProperties": false, "properties": {"weight": {"$ref": "#/$defs/unit"}, "height": {"type": "integer", "minimum": 0}}}, "north_facing": {"$ref": "#/$defs/unit"}}},
      "cracks": {"type": "object", "additionalProperties": false, "properties": {"amount": {"$ref": "#/$defs/unit"}, "exposure": {"$ref": "#/$defs/unit"}}}, "missing_blocks": {"$ref": "#/$defs/unit"}, "vegetation": {"$ref": "#/$defs/unit"}}},
    "decoration": {"$ref": "#/$defs/unitObject"},
    "palette": {"type": "object", "additionalProperties": false, "properties": {"variation": {"$ref": "#/$defs/unit"}, "contrast": {"$ref": "#/$defs/unit"}, "saturation": {"$ref": "#/$defs/unit"}, "accent": {"$ref": "#/$defs/unit"}, "mix": {"$ref": "#/$defs/unit"}, "materials": {"type": "object", "additionalProperties": {"oneOf": [{"$ref": "#/$defs/material"}, {"type": "array", "minItems": 1, "items": {"type": "string"}}]}}}},
    "terrain": {"type": "object", "additionalProperties": false, "properties": {"roughness": {"$ref": "#/$defs/unit"}, "amplitude": {"$ref": "#/$defs/unit"}, "noise": {"type": "object", "additionalProperties": false, "properties": {"scale": {"type": "number", "exclusiveMinimum": 0}, "octaves": {"type": "integer", "minimum": 1}, "persistence": {"$ref": "#/$defs/unit"}}}, "erosion": {"$ref": "#/$defs/unit"}, "caves": {"$ref": "#/$defs/unit"}, "water_level": {"type": ["integer", "null"]}, "vegetation": {"$ref": "#/$defs/unit"}}},
    "preview": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "mode": {"enum": ["3d", "2d"]}, "quality": {"enum": ["auto", "low", "medium", "high"]}, "shadows": {"type": "boolean"}, "brightness": {"$ref": "#/$defs/unit"}, "time_of_day": {"type": "integer", "minimum": 0, "maximum": 23999}, "block_light": {"type": "boolean"}, "shader": {"enum": ["vanilla", "soft", "cinematic"]}, "open_browser": {"type": "boolean"}, "biome": {"type": ["string", "null"]}}},
    "assets": {"type": "object", "additionalProperties": false, "properties": {"minecraft_dir": {"type": ["string", "null"]}, "download": {"enum": ["ask", true, false]}}},
    "render": {"type": "object", "additionalProperties": false, "properties": {"browser": {"type": "string"}, "gpu": {"enum": ["auto", "swiftshader"]}, "timeout_seconds": {"type": "number", "exclusiveMinimum": 0}}},
    "output": {"type": "object", "additionalProperties": false, "properties": {"format": {"enum": ["schem", "litematic"]}, "directory": {"type": "string"}, "emit": {"type": "array", "items": {"enum": ["resolve", "site", "massing", "detail", "blueprint"]}}}},
    "limits": {"type": "object", "additionalProperties": false, "properties": {"region": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 1}, {"type": ["integer", "null"], "minimum": 1}, {"type": "integer", "minimum": 1}], "minItems": 3, "maxItems": 3}, "halo": {"type": "integer", "minimum": 0}, "max_memory_mb": {"type": "integer", "minimum": 1}}}
  },
  "$defs": {
    "unit": {"type": "number", "minimum": 0, "maximum": 1},
    "unitObject": {"type": "object", "additionalProperties": false, "properties": {"density": {"$ref": "#/$defs/unit"}, "depth": {"$ref": "#/$defs/unit"}, "symmetry": {"$ref": "#/$defs/unit"}}},
    "material": {"oneOf": [
      {"type": "string", "minLength": 1},
      {"type": "object", "anyOf": [{"required": ["color"]}, {"required": ["material"]}], "additionalProperties": false, "properties": {
        "color": {"type": "array", "prefixItems": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": -0.4, "maximum": 0.4}, {"type": "number", "minimum": -0.4, "maximum": 0.4}], "minItems": 3, "maxItems": 3},
        "material": {"type": "string", "minLength": 1}
      }}
    ]}
  }
}
