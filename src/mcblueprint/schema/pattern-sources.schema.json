{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pattern sources v1",
  "type": "object",
  "required": [
    "formatVersion",
    "sources"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "license"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "format": "uri"
          },
          "license": {
            "type": "string"
          },
          "attribution": {
            "type": "string"
          },
          "modules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
