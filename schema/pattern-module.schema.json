{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pattern module v1",
  "type": "object",
  "required": [
    "formatVersion",
    "name",
    "operations"
  ],
  "additionalProperties": false,
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+[.][a-z0-9_-]+$"
    },
    "description": {
      "type": "string"
    },
    "palettes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9_]+$"
      },
      "additionalProperties": {
        "$ref": "blueprint.schema.json#/$defs/palette"
      }
    },
    "operations": {
      "$ref": "blueprint.schema.json#/$defs/operations"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "integer",
              "number",
              "string",
              "boolean"
            ]
          },
          "default": {},
          "minimum": {
            "type": "number"
          },
          "maximum": {
            "type": "number"
          },
          "enum": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "integer"
                }
              }
            },
            "then": {
              "properties": {
                "default": {
                  "type": "integer"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "number"
                }
              }
            },
            "then": {
              "properties": {
                "default": {
                  "type": "number"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "string"
                }
              }
            },
            "then": {
              "properties": {
                "default": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "boolean"
                }
              }
            },
            "then": {
              "properties": {
                "default": {
                  "type": "boolean"
                }
              }
            }
          }
        ]
      }
    },
    "anchors": {
      "type": "object",
      "additionalProperties": {
        "$ref": "blueprint.schema.json#/$defs/position"
      }
    },
    "author": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "roleReference": {
      "type": "object",
      "required": [
        "role",
        "shape",
        "state"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$id": "https://github.com/mc-blueprint/mc-blueprint/schema/pattern-module.schema.json"
}
