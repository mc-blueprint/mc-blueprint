{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mc-blueprint/mc-blueprint/schema/colorpack.schema.json",
  "title": "配色パック v1",
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": 1,
      "type": "integer"
    },
    "packVersion": {
      "type": "string",
      "not": {"pattern": "\\s"},
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "taxonomyVersion": {
      "const": "0.1.0"
    },
    "vocabularyVersion": {
      "const": "1.0.0"
    },
    "palettePrior": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "when": {
            "$ref": "#/$defs/when"
          },
          "roles": {
            "type": "object",
            "propertyNames": {
              "$ref": "#/$defs/role"
            },
            "additionalProperties": {
              "$ref": "#/$defs/palette"
            },
            "minProperties": 1
          }
        },
        "required": [
          "when",
          "roles"
        ],
        "additionalProperties": false
      }
    },
    "materialPrior": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "when": {
            "$ref": "#/$defs/when"
          },
          "roles": {
            "type": "object",
            "propertyNames": {
              "$ref": "#/$defs/role"
            },
            "additionalProperties": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/material"
              },
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              },
              "minProperties": 1
            },
            "minProperties": 1
          }
        },
        "required": [
          "when",
          "roles"
        ],
        "additionalProperties": false
      }
    },
    "relationRule": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "accentRule": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "when": {
            "$ref": "#/$defs/when"
          },
          "role": {
            "$ref": "#/$defs/role"
          },
          "maxAreaRatio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "when",
          "role",
          "maxAreaRatio"
        ],
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "dataLicense": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "inputs": {
          "type": "integer",
          "minimum": 0
        },
        "subjects": {
          "type": "integer",
          "minimum": 0
        },
        "licenses": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "attributions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "author": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "license": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "source",
              "author",
              "license",
              "url"
            ],
            "additionalProperties": false
          }
        },
        "snapshot": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "sha256": {
              "type": "string",
          "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "id",
            "sha256"
          ],
          "additionalProperties": false
        },
        "generator": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "commit": {
              "type": "string",
          "maxLength": 40,
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "repository",
            "commit"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "dataLicense",
        "inputs",
        "subjects",
        "licenses",
        "attributions",
        "snapshot",
        "generator"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "formatVersion",
    "packVersion",
    "taxonomyVersion",
    "vocabularyVersion",
    "palettePrior",
    "materialPrior",
    "relationRule",
    "accentRule",
    "provenance"
  ],
  "additionalProperties": false,
  "$defs": {
    "style": {
      "enum": [
        "medieval",
        "japanese",
        "modern"
      ]
    },
    "buildingType": {
      "enum": [
        "house",
        "tower",
        "castle"
      ]
    },
    "biomeLike": {
      "enum": [
        "plains",
        "forest",
        "taiga",
        "jungle",
        "savanna",
        "desert",
        "badlands",
        "swamp",
        "mountains",
        "snowy",
        "ocean",
        "river",
        "beach",
        "mushroom_fields",
        "nether",
        "end"
      ]
    },
    "role": {
      "enum": [
        "foundation",
        "wall_main",
        "wall_secondary",
        "frame",
        "roof",
        "trim",
        "window_frame",
        "floor",
        "path",
        "accent"
      ]
    },
    "material": {
      "enum": [
        "stone",
        "brick",
        "wood",
        "plaster",
        "terracotta",
        "concrete",
        "metal",
        "glass",
        "soil",
        "sand",
        "plant",
        "wool",
        "ice_snow",
        "ore",
        "mineral",
        "light",
        "liquid",
        "other"
      ]
    },
    "when": {
      "type": "object",
      "properties": {
        "style": {
          "$ref": "#/$defs/style"
        },
        "buildingType": {
          "$ref": "#/$defs/buildingType"
        },
        "biomeLike": {
          "$ref": "#/$defs/biomeLike"
        }
      },
      "required": [],
      "additionalProperties": false,
      "dependentRequired": {
        "buildingType": [
          "style",
          "biomeLike"
        ],
        "biomeLike": [
          "style"
        ]
      }
    },
    "palette": {
      "type": "object",
      "properties": {
        "oklab": {
          "type": "object",
          "properties": {
            "L": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minItems": 5,
              "maxItems": 5
            },
            "a": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -0.4,
                "maximum": 0.4
              },
              "minItems": 5,
              "maxItems": 5
            },
            "b": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -0.4,
                "maximum": 0.4
              },
              "minItems": 5,
              "maxItems": 5
            }
          },
          "required": [
            "L",
            "a",
            "b"
          ],
          "additionalProperties": false
        },
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "subjects": {
          "type": "integer",
          "minimum": 0
        },
        "nEff": {
          "type": "number",
          "minimum": 0
        },
        "support": {
          "$ref": "#/$defs/support"
        }
      },
      "required": [
        "oklab",
        "n",
        "subjects",
        "nEff"
      ],
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "properties": {
        "when": {
          "$ref": "#/$defs/when"
        },
        "pair": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/role"
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "dL": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "minItems": 5,
          "maxItems": 5
        },
        "dC": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -0.565685424949238,
            "maximum": 0.565685424949238
          },
          "minItems": 5,
          "maxItems": 5
        },
        "dh": {
          "type": "object",
          "properties": {
            "origin": {
              "type": "number",
              "minimum": -3.141592653589793,
              "exclusiveMaximum": 3.141592653589793
            },
            "quantiles": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -3.141592653589793,
                "maximum": 3.141592653589793
              },
              "minItems": 5,
              "maxItems": 5
            }
          },
          "required": [
            "origin",
            "quantiles"
          ],
          "additionalProperties": false
        },
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "subjects": {
          "type": "integer",
          "minimum": 0
        },
        "nEff": {
          "type": "number",
          "minimum": 0
        },
        "support": {
          "$ref": "#/$defs/support"
        }
      },
      "required": [
        "when",
        "pair",
        "dL",
        "dC",
        "dh",
        "n",
        "subjects",
        "nEff"
      ],
      "additionalProperties": false
    },
    "support": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "direct"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "smoothed"
            },
            "sourceWhen": {
              "$ref": "#/$defs/when"
            }
          },
          "required": [
            "status",
            "sourceWhen"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
